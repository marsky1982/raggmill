# 运行时数据（含 data/secret.key、上传原文、KG、测试集、单实例锁）——绝不入库
data/

# Python
backend/.venv/
__pycache__/
*.pyc
.pytest_cache/
# OpenAPI 中间产物（前端类型由 npm run gen:api 生成后入库，JSON 本身不入库）
backend/openapi.json

# 前端
frontend/node_modules/
frontend/dist/
frontend/.env.local
# Playwright 端到端验收产物（报告与失败截图只在本地看，不入库）
frontend/playwright-report/
frontend/test-results/

# 本地备份 / 工作树 / 工具配置
.backups/
.worktrees/
.claude/
.trae/
.trae-tmp/
.trae-html-share-packages/
.workbuddy/
designs/
.screenshots/
*.pid
*.log
*.tsbuildinfo
frontend/vite.config.ts.timestamp-*.mjs

# docker compose 自动读取的部署变量（含写令牌等），不进仓库
/.env
